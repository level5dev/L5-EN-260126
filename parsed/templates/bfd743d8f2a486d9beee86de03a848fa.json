{
  "components/page/schematic": "\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css\">\n<style>\n\n</style>\n<div id=\"\">\n  <div class=\"\" id=\"\">\n  {{!--> components/common/breadcrumbs breadcrumbs=breadcrumbs--}}\n  <nav aria-label=\"Breadcrumb\">\n    <ol class=\"breadcrumbs\" itemscope itemtype=\"https://schema.org/BreadcrumbList\" style=\"\n    text-align: left;\">\n        <li class=\"breadcrumb\" itemprop=\"itemListElement\" itemscope itemtype=\"https://schema.org/ListItem\">\n            <a href=\"javascript:void(0)\" class=\"home-link\" onclick=\"goToHomePage()\">\n                <i class=\"fas fa-home\"></i>\n            </a>\n            <a class=\"breadcrumb-label\" itemprop=\"item\" href=\"{{url}}\">\n                <span itemprop=\"name\" style=\"text-transform: uppercase;font-weight: 400;\"> / {{lang 'common.customer_support'}}</span>\n            </a>\n        </li>\n    </ol>\n    </nav>\n    <div class=\"cont tools w-container finTitle\">\n        <div class=\"align--ctr\">\n            <h1 class=\"page-heading section--header__sm\">{{lang (lang 'custom.page.schematic.title')}}</h1>\n        </div>\n    </div>\n   \n{{> components/custom/schematic/tube-taper}}\n{{> components/custom/schematic/tube-taper-2}}\n\n</div>\n<script src=\"https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=634d1196dfe3ee1059acb423\" type=\"text/javascript\" integrity=\"sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=\" crossorigin=\"anonymous\"></script>\n<!--script src=\"{{cdn 'assets/js/theme/custom/financing.js'}}\" type=\"module\"></script-->\n\n<script>\n\n</script>\n\n",
  "components/custom/schematic/tube-taper": "<section class=\"sch--cont\" schematic-sec>\r\n    <a class=\"dropdown-toggle w-dropdown-toggle\" data-accordion-sch >\r\n        <h4 style=\"margin-bottom:0px\">{{lang (lang 'custom.page.parts-components.schematic.schematic.title')}}</h4>\r\n        <i class=\"fas fa-sharp fa-chevron-right\" style=\"color: #000000;\" accordion-ddown-sch></i>\r\n    </a>\r\n    <div class=\"schematic-block tab-content-sch\" style=\"margin-bottom:0px;\">\r\n        <div class=\"div-block-201\">\r\n            <div style=\"display: grid;\">\r\n                <p>{{lang 'custom.page.parts-components.compatible_with_sku'}}: {{lang (lang 'custom.page.parts-components.schematic.schematic.subtitle')}}</p>\r\n                <a href=\"{{lang (lang 'custom.page.parts-components.schematic.schematic.pdf_link')}}\" download target=\"_blank\">\r\n                    <img src=\"{{lang (lang 'custom.page.parts-components.schematic.schematic.image')}}\" loading=\"lazy\" sizes=\"(max-width: 479px) 90vw, 300px\" alt=\"\" class=\"image-78\">\r\n                </a>\r\n                {{> components/custom/schematic/download-pdf pdf=(lang 'custom.page.parts-components.schematic.schematic.pdf_link')}}\r\n            </div>\r\n        </div>\r\n        <div class=\"layout-grid grid-row\">\r\n            {{> components/custom/schematic/table-header}}\r\n            {{#for 1 (lang 'custom.page.parts-components.schematic.schematic.item_num')}}\r\n                {{> components/custom/schematic/schematic-item-list \r\n                    index = $index\r\n                    id = (lang (concat (concat 'custom.page.parts-components.schematic.schematic.item_' $index) '.id'))\r\n                    sku =(lang (concat (concat 'custom.page.parts-components.schematic.schematic.item_' $index) '.sku'))\r\n                    name = (lang (concat (concat 'custom.page.parts-components.schematic.schematic.item_' $index) '.name'))\r\n                    price = (lang (concat (concat 'custom.page.parts-components.schematic.schematic.item_' $index) '.price'))\r\n                    quantity = (lang (concat (concat 'custom.page.parts-components.schematic.schematic.item_' $index) '.quantity'))\r\n                }}\r\n            {{/for}}\r\n        </div>\r\n        <div style=\"margin-bottom: 10px;\"></div>\r\n    </div>\r\n</section>\r\n",
  "components/custom/schematic/tube-taper-2": "<section class=\"sch--cont\" schematic-sec>\n    <a class=\"dropdown-toggle w-dropdown-toggle\" data-accordion-sch >\n        <h3 style=\"margin-bottom:0px\">{{lang (lang 'custom.page.parts-components.schematic.schematic-2.title')}}</h3>\n        <i class=\"fas fa-sharp fa-chevron-right\" style=\"color: #000000;\" accordion-ddown-sch></i>\n    </a>\n    <div class=\"schematic-block tab-content-sch\" style=\"margin-bottom:0px;\">\n        <div class=\"div-block-201\">\n            <div style=\"display: grid;\">\n                <p>{{lang 'custom.page.parts-components.compatible_with_sku'}}: {{lang (lang 'custom.page.parts-components.schematic.schematic-2.subtitle')}}</p>\n                <a href=\"{{lang (lang 'custom.page.parts-components.schematic.schematic-2.pdf_link')}}\" download target=\"_blank\">\n                    <img src=\"{{lang (lang 'custom.page.parts-components.schematic.schematic-2.image')}}\" loading=\"lazy\" sizes=\"(max-width: 479px) 90vw, 300px\" alt=\"\" class=\"image-78\">\n                </a>\n                {{> components/custom/schematic/download-pdf pdf=(lang 'custom.page.parts-components.schematic.schematic-2.pdf_link')}}\n            </div>\n        </div>\n        <div class=\"layout-grid grid-row\">\n            {{> components/custom/schematic/table-header}}\n            {{#for 1 (lang 'custom.page.parts-components.schematic.schematic-2.item_num')}}\n                {{> components/custom/schematic/schematic-item-list \n                    index = $index\n                    id = (lang (concat (concat 'custom.page.parts-components.schematic.schematic-2.item_' $index) '.id'))\n                    sku =(lang (concat (concat 'custom.page.parts-components.schematic.schematic-2.item_' $index) '.sku'))\n                    name = (lang (concat (concat 'custom.page.parts-components.schematic.schematic-2.item_' $index) '.name'))\n                    price = (lang (concat (concat 'custom.page.parts-components.schematic.schematic-2.item_' $index) '.price'))\n                    quantity = (lang (concat (concat 'custom.page.parts-components.schematic.schematic-2.item_' $index) '.quantity'))\n                }}\n            {{/for}}\n        </div>\n        <div style=\"margin-bottom: 10px;\"></div>\n    </div>\n</section>\n",
  "components/custom/schematic/download-pdf": "<a style=\"margin-top: 10px;\" href=\"{{pdf}}\" download target=\"_blank\" class=\"a--link\">{{lang 'custom.page.parts-components.download_pdf'}}</a>\n<a style=\"margin-top: 20px;\" href=\"{{pdf}}\" download target=\"_blank\" class=\"button--primary a--link-mob\">{{lang 'custom.page.parts-components.download_pdf'}}</a>\n",
  "components/custom/schematic/schematic-item-list": "<div class=\"grid-item index-wrapper over-padding-left\" style=\"justify-content:center;\">\r\n    <div class=\"index-round\">{{index}}</div>\r\n</div>\r\n<div class=\"grid-item sch-item-sku\">{{sku}}</div>\r\n<div class=\"grid-item sch-item-name-wrapper\">\r\n    <div class=\"item--name sch-item-desc\">{{name}}</div>\r\n    {{#if quantity '==' 0}}\r\n    <p class=\"text-sm-red\">Not Available</p>\r\n    {{/if}}\r\n</div>\r\n{{!-- #if price '==' '0'}}\r\n    <div class=\"grid-item\"></div>\r\n    <div class=\"grid-item js-card-atc\" style=\"justify-content: end;\">\r\n        <button class=\"button sch-btn-disabled\" disabled>{{lang 'unavailable.text'}}</button>\r\n    </div>\r\n{{else --}}\r\n<div id=\"\" class=\"grid-item\">${{price}}</div>\r\n    \r\n<div class=\"grid-item js-card-atc over-padding-right\">\r\n    <div class=\"card-atc__section card-atc__section--qty\">\r\n        <label for=\"card-atc__qty-{{id}}\" class=\"card-atc__label is-srOnly\">{{lang 'products.quantity'}}:</label>\r\n        <div class=\"card-atc-increment--has-buttons js-card-atc-increment\">\r\n            <div class=\"form-increment incr-mob\">\r\n                <button class=\"button button--icon\" data-action=\"dec\" type=\"button\" tabindex=\"0\">\r\n                    <span class=\"icon-wrapper\" aria-hidden=\"true\">\r\n                        <svg class=\"icon\">\r\n                            <use xlink:href=\"#icon-keyboard-arrow-down\"></use>\r\n                        </svg>\r\n                    </span>\r\n                </button>\r\n                <input type=\"tel\" class=\"form-input form-input--incrementTotal js-card-atc__input--total\" name=\"card-atc__qty-{{id}}\" id=\"card-atc__qty-{{id}}\" value=\"1\" min=\"1\" pattern=\"[0-9]*\" aria-live=\"polite\" tabindex=\"0\">\r\n                <button class=\"button button--icon\" data-action=\"inc\" type=\"button\" tabindex=\"0\">\r\n                    <span class=\"icon-wrapper\" aria-hidden=\"true\">\r\n                        <svg class=\"icon\">\r\n                            <use xlink:href=\"#icon-keyboard-arrow-up\"></use>\r\n                        </svg>\r\n                    </span>\r\n                </button>\r\n            </div>\r\n        </div>\r\n    </div>\r\n    <div class=\"card-atc__section card-atc__section--action adc-col\">\r\n        {{#if quantity '==' 0}}\r\n        <button type=\"button\" class=\"card-atc__button button adc-btn\" disabled>{{lang 'products.add_to_cart'}}</button>\r\n        <button type=\"button\" class=\"button parts s2 w-button adc-btn-mob\" disabled>{{lang 'products.add'}}</button>\r\n        {{else}}\r\n        <button type=\"button\" class=\"card-atc__button button button--primary js-card-atc__button adc-btn\" id=\"card-atc__add-{{id}}\" data-default-message=\"{{lang 'products.add_to_cart'}}\" data-wait-message=\"{{lang 'products.adding_to_cart'}}\" data-added-message=\"{{lang 'products.add_to_cart'}}\" value=\"{{lang 'products.add_to_cart'}}\" data-card-add-to-cart=\"/cart.php?action=add&amp;product_id={{id}}\" data-event-type=\"product-click\" tabindex=\"0\">{{lang 'products.add_to_cart'}}</button>\r\n        <button type=\"button\" class=\"button button--primary js-card-atc__button parts s2 w-button adc-btn-mob\" id=\"card-atc__add-{{id}}\" data-default-message=\"{{lang 'add'}}\" data-wait-message=\"…\" data-added-message=\"{{lang 'products.add'}}\" value=\"{{lang 'products.add'}}\" data-card-add-to-cart=\"/cart.php?action=add&amp;product_id={{id}}\" data-event-type=\"product-click\" tabindex=\"0\">{{lang 'products.add'}}</button>\r\n        <span class=\"product-status-message aria-description--hidden\">{{lang 'products.add_to_cart_item_added'}}</span>\r\n        {{/if}}\r\n    </div>\r\n    <div id=\"previewModal\" class=\"modal modal--large\" data-reveal>\r\n        <button class=\"modal-close\" type=\"button\" title=\"Close\">\r\n            <span class=\"aria-description--hidden\">{{lang 'common.close'}}</span>\r\n            <span aria-hidden=\"true\">&#215;</span>\r\n        </button>\r\n        <div class=\"modal-content\"></div>\r\n        <div class=\"loadingOverlay\"></div>\r\n    </div>\r\n</div>\r\n\r\n{{!-- /if --}}\r\n",
  "components/custom/schematic/table-header": "\n<div class=\"grid-item heading sch--col-mob\">{{lang 'custom.page.parts-components.table.schematic'}} #</div>\n<div class=\"grid-item heading sch--col-mobile over-padding-left\">#</div>\n<div class=\"grid-item heading\">{{lang 'custom.page.parts-components.table.part'}} <span class=\"sch--col-mob\"> #</span></div>\n<div class=\"grid-item heading sch-item-desc\">{{lang 'products.description'}}</div>\n<div class=\"grid-item heading\">{{lang 'invoice.price'}}</div>\n<div class=\"grid-item heading over-padding-right\">{{lang 'products.add_to_cart'}}</div>\n"
}
