{
  "components/common/quick-search-mobile": "<form\n  class=\"form--search_mobile\"\n  onsubmit=\"return false\"\n  data-url=\"{{urls.search}}\"\n  data-quick-search-form\n>\n  <fieldset class=\"form-fieldset\">\n    <div class=\"form--search_mobile-content\">\n      <input\n        class=\"form-input\"\n        name=\"{{name}}\"\n        id=\"{{name}}\"\n        data-error-message=\"{{lang 'search.error.empty_field'}}\"\n        autocomplete=\"off\"\n        placeholder=\"Your search...\"\n      />\n      <button type=\"submit\">SEARCH</button>\n    </div>\n  </fieldset>\n  <div\n    class=\"form--search_mobile__close-button\"\n    id=\"search-mobile-button-close\"\n  >\n    <svg\n      aria-hidden=\"true\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n      width=\"35\"\n      height=\"35\"\n      fill=\"none\"\n      viewBox=\"0 0 24 24\"\n    >\n      <path\n        stroke=\"white\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        stroke-width=\"1\"\n        d=\"M6 18 17.94 6M18 18 6.06 6\"\n      />\n    </svg>\n  </div>\n</form>\n"
}
