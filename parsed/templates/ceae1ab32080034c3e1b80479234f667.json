{
  "components/custom/schematic/7293-Gooser-Assembly": "<section class=\"sch--cont\" schematic-sec>\r\n    <a class=\"dropdown-toggle w-dropdown-toggle\" data-accordion-sch >\r\n        <h4 style=\"margin-bottom:0px\">{{lang (lang 'custom.page.parts-components.schematic.7293-Gooser-Assembly.title')}}</h4>\r\n        <i class=\"fas fa-sharp fa-chevron-right\" style=\"color: #000000;\" accordion-ddown-sch></i>\r\n    </a>\r\n    <div class=\"schematic-block tab-content-sch\" style=\"margin-bottom:0px;\">\r\n        <div class=\"div-block-201\">\r\n            <div style=\"display: grid;\">\r\n                <p>{{lang 'custom.page.parts-components.compatible_with_sku'}}: {{lang (lang 'custom.page.parts-components.schematic.7293-Gooser-Assembly.subtitle')}}</p>\r\n                <a href=\"{{lang (lang 'custom.page.parts-components.schematic.7293-Gooser-Assembly.pdf_link')}}\" download target=\"_blank\">\r\n                    <img src=\"{{lang (lang 'custom.page.parts-components.schematic.7293-Gooser-Assembly.image')}}\" loading=\"lazy\" sizes=\"(max-width: 479px) 90vw, 300px\" alt=\"\" class=\"image-78\">\r\n                </a>\r\n                {{> components/custom/schematic/download-pdf pdf=(lang 'custom.page.parts-components.schematic.7293-Gooser-Assembly.pdf_link')}}\r\n            </div>\r\n        </div>\r\n        {{!-- <table>\r\n            <thead>\r\n                <tr>\r\n                    <th class=\"sch--col-mob\">SCHEMATIC #<span class=\"sch--col-mobile\"> #</span></th>\r\n                    <th class=\"\">PART <span class=\"sch--col-mob\"> #</span> </th>\r\n                    <th class=\"sch-item-desc\">DESCRIPTION</th>\r\n                    <th class=\"\">PRICE</th>\r\n                    <th class=\"\">{{lang 'products.add_to_cart'}}</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {{#for 1 (lang 'custom.page.parts-components.schematic.7293-Gooser-Assembly.item_num') }}\r\n                <tr>\r\n                    {{> components/custom/schematic/table-body \r\n                        index = $index\r\n                        id = (lang (concat (concat 'custom.page.parts-components.schematic.7293-Gooser-Assembly.item_' $index) '.id'))\r\n                        sku =(lang (concat (concat 'custom.page.parts-components.schematic.7293-Gooser-Assembly.item_' $index) '.sku'))\r\n                        name = (lang (concat (concat 'custom.page.parts-components.schematic.7293-Gooser-Assembly.item_' $index) '.name'))\r\n                        price = (lang (concat (concat 'custom.page.parts-components.schematic.7293-Gooser-Assembly.item_' $index) '.price'))\r\n                        quantity = (lang (concat (concat 'custom.page.parts-components.schematic.7293-Gooser-Assembly.item_' $index) '.quantity'))\r\n                    }}\r\n                </tr>\r\n                <tr class=\"line-border\"></tr>\r\n                {{/for}}\r\n            </tbody>\r\n        </table> --}}\r\n        <div class=\"layout-grid grid-row\">\r\n            {{> components/custom/schematic/table-header}}\r\n            {{#for 1 (lang 'custom.page.parts-components.schematic.7293-Gooser-Assembly.item_num')}}\r\n                {{> components/custom/schematic/schematic-item-list \r\n                    index = $index\r\n                    id = (lang (concat (concat 'custom.page.parts-components.schematic.7293-Gooser-Assembly.item_' $index) '.id'))\r\n                    sku =(lang (concat (concat 'custom.page.parts-components.schematic.7293-Gooser-Assembly.item_' $index) '.sku'))\r\n                    name = (lang (concat (concat 'custom.page.parts-components.schematic.7293-Gooser-Assembly.item_' $index) '.name'))\r\n                    price = (lang (concat (concat 'custom.page.parts-components.schematic.7293-Gooser-Assembly.item_' $index) '.price'))\r\n                    quantity = (lang (concat (concat 'custom.page.parts-components.schematic.7293-Gooser-Assembly.item_' $index) '.quantity'))\r\n                }}\r\n            {{/for}}\r\n        </div>\r\n        <div style=\"margin-bottom: 10px;\"></div>\r\n    </div>\r\n</section>\r\n{{!-- <style>\r\n    table {\r\n      width: 100%;\r\n      border-collapse: collapse;\r\n      margin-bottom: 20px;\r\n    }\r\n\r\n    .line-border {\r\n    position: relative;\r\n  }\r\n\r\n  .line-border:after {\r\n    content: '';\r\n    display: block;\r\n    position: absolute;\r\n    left: -50%; /* Adjust to exceed the table on the left */\r\n    right: -50%; /* Adjust to exceed the table on the right */\r\n    bottom: -1px; /* Adjust to position the border at the bottom */\r\n    height: 1px;\r\n    background-color: #ddd; /* Border color */\r\n  }\r\n\r\n    th {\r\n        text-align: start;\r\n      //background-color: #f2f2f2;\r\n    }\r\n\r\n    th:nth-child(1),\r\n    td:nth-child(1) {\r\n      width: 10%; /* Adjust the width as needed */\r\n    }\r\n\r\n    th:nth-child(2),\r\n    td:nth-child(2) {\r\n      width: 10%; /* Adjust the width as needed */\r\n    }\r\n\r\n    th:nth-child(3),\r\n    td:nth-child(3) {\r\n      width: 60%;\r\n    }\r\n\r\n    th:nth-child(4),\r\n    td:nth-child(4) {\r\n      width: 10%; /* Adjust the width as needed */\r\n    }\r\n\r\n    th:nth-child(5),\r\n    td:nth-child(5) {\r\n      width: 10%; /* Adjust the width as needed */\r\n      .grid-item {\r\n        padding-right: 0;\r\n      }\r\n    }\r\n  </style> --}}\r\n",
  "components/custom/schematic/table-header": "\n<div class=\"grid-item heading sch--col-mob\">{{lang 'custom.page.parts-components.table.schematic'}} #</div>\n<div class=\"grid-item heading sch--col-mobile over-padding-left\">#</div>\n<div class=\"grid-item heading\">{{lang 'custom.page.parts-components.table.part'}} <span class=\"sch--col-mob\"> #</span></div>\n<div class=\"grid-item heading sch-item-desc\">{{lang 'products.description'}}</div>\n<div class=\"grid-item heading\">{{lang 'invoice.price'}}</div>\n<div class=\"grid-item heading over-padding-right\">{{lang 'products.add_to_cart'}}</div>\n",
  "components/custom/schematic/table-body": "<td class=\"index-wrapper\" style=\"justify-content:center;\">\r\n    <div class=\"index-round\">{{index}}</div>\r\n</td>\r\n<td class=\"\">{{sku}}</td>\r\n<td class=\"\">\r\n    <div class=\"item--name\">{{name}}</div>\r\n    {{#if quantity '==' 0}}\r\n    <p class=\"text-sm-red\">Not Available</p>\r\n    {{/if}}\r\n</td>\r\n{{!-- #if price '==' '0'}}\r\n    <div class=\"grid-item\"></div>\r\n    <div class=\"grid-item js-card-atc\" style=\"justify-content: end;\">\r\n        <button class=\"button sch-btn-disabled\" disabled>{{lang 'unavailable.text'}}</button>\r\n    </div>\r\n{{else --}}\r\n<td id=\"\" class=\"\">${{price}}</td>\r\n<td>\r\n    <div class=\"grid-item js-card-atc\">\r\n        <div class=\"card-atc__section card-atc__section--qty\">\r\n            <label for=\"card-atc__qty-{{id}}\" class=\"card-atc__label is-srOnly\">{{lang 'products.quantity'}}:</label>\r\n            <div class=\"card-atc-increment--has-buttons js-card-atc-increment\">\r\n                <div class=\"form-increment incr-mob\">\r\n                    <button class=\"button button--icon\" data-action=\"dec\" type=\"button\" tabindex=\"0\">\r\n                        <span class=\"icon-wrapper\" aria-hidden=\"true\">\r\n                            <svg class=\"icon\">\r\n                                <use xlink:href=\"#icon-keyboard-arrow-down\"></use>\r\n                            </svg>\r\n                        </span>\r\n                    </button>\r\n                    <input type=\"tel\" class=\"form-input form-input--incrementTotal js-card-atc__input--total\" name=\"card-atc__qty-{{id}}\" id=\"card-atc__qty-{{id}}\" value=\"1\" min=\"1\" pattern=\"[0-9]*\" aria-live=\"polite\" tabindex=\"0\">\r\n                    <button class=\"button button--icon\" data-action=\"inc\" type=\"button\" tabindex=\"0\">\r\n                        <span class=\"icon-wrapper\" aria-hidden=\"true\">\r\n                            <svg class=\"icon\">\r\n                                <use xlink:href=\"#icon-keyboard-arrow-up\"></use>\r\n                            </svg>\r\n                        </span>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div class=\"card-atc__section card-atc__section--action adc-col\">\r\n            {{#if quantity '==' 0}}\r\n            <button type=\"button\" class=\"card-atc__button button adc-btn\" disabled>{{lang 'products.add_to_cart'}}</button>\r\n            <button type=\"button\" class=\"button parts s2 w-button adc-btn-mob\" disabled>{{lang 'products.add'}}</button>\r\n            {{else}}\r\n            <button type=\"button\" class=\"card-atc__button button button--primary js-card-atc__button adc-btn\" id=\"card-atc__add-{{id}}\" data-default-message=\"{{lang 'products.add_to_cart'}}\" data-wait-message=\"{{lang 'products.adding_to_cart'}}\" data-added-message=\"{{lang 'products.add_to_cart'}}\" value=\"{{lang 'products.add_to_cart'}}\" data-card-add-to-cart=\"/cart.php?action=add&amp;product_id={{id}}\" data-event-type=\"product-click\" tabindex=\"0\">{{lang 'products.add_to_cart'}}</button>\r\n            <button type=\"button\" class=\"button button--primary js-card-atc__button parts s2 w-button adc-btn-mob\" id=\"card-atc__add-{{id}}\" data-default-message=\"{{lang 'add'}}\" data-wait-message=\"…\" data-added-message=\"{{lang 'products.add'}}\" value=\"{{lang 'products.add'}}\" data-card-add-to-cart=\"/cart.php?action=add&amp;product_id={{id}}\" data-event-type=\"product-click\" tabindex=\"0\">{{lang 'products.add'}}</button>\r\n            <span class=\"product-status-message aria-description--hidden\">{{lang 'products.add_to_cart_item_added'}}</span>\r\n            {{/if}}\r\n        </div>\r\n        <div id=\"previewModal\" class=\"modal modal--large\" data-reveal>\r\n            <button class=\"modal-close\" type=\"button\" title=\"{{lang 'common.close'}}\">\r\n                <span class=\"aria-description--hidden\">{{lang 'common.close'}}</span>\r\n                <span aria-hidden=\"true\">&#215;</span>\r\n            </button>\r\n            <div class=\"modal-content\"></div>\r\n            <div class=\"loadingOverlay\"></div>\r\n        </div>\r\n    </div>\r\n</td>\r\n{{!-- /if --}}\r\n",
  "components/custom/schematic/download-pdf": "<a style=\"margin-top: 10px;\" href=\"{{pdf}}\" download target=\"_blank\" class=\"a--link\">{{lang 'custom.page.parts-components.download_pdf'}}</a>\n<a style=\"margin-top: 20px;\" href=\"{{pdf}}\" download target=\"_blank\" class=\"button--primary a--link-mob\">{{lang 'custom.page.parts-components.download_pdf'}}</a>\n",
  "components/custom/schematic/schematic-item-list": "<div class=\"grid-item index-wrapper over-padding-left\" style=\"justify-content:center;\">\r\n    <div class=\"index-round\">{{index}}</div>\r\n</div>\r\n<div class=\"grid-item sch-item-sku\">{{sku}}</div>\r\n<div class=\"grid-item sch-item-name-wrapper\">\r\n    <div class=\"item--name sch-item-desc\">{{name}}</div>\r\n    {{#if quantity '==' 0}}\r\n    <p class=\"text-sm-red\">Not Available</p>\r\n    {{/if}}\r\n</div>\r\n{{!-- #if price '==' '0'}}\r\n    <div class=\"grid-item\"></div>\r\n    <div class=\"grid-item js-card-atc\" style=\"justify-content: end;\">\r\n        <button class=\"button sch-btn-disabled\" disabled>{{lang 'unavailable.text'}}</button>\r\n    </div>\r\n{{else --}}\r\n<div id=\"\" class=\"grid-item\">${{price}}</div>\r\n    \r\n<div class=\"grid-item js-card-atc over-padding-right\">\r\n    <div class=\"card-atc__section card-atc__section--qty\">\r\n        <label for=\"card-atc__qty-{{id}}\" class=\"card-atc__label is-srOnly\">{{lang 'products.quantity'}}:</label>\r\n        <div class=\"card-atc-increment--has-buttons js-card-atc-increment\">\r\n            <div class=\"form-increment incr-mob\">\r\n                <button class=\"button button--icon\" data-action=\"dec\" type=\"button\" tabindex=\"0\">\r\n                    <span class=\"icon-wrapper\" aria-hidden=\"true\">\r\n                        <svg class=\"icon\">\r\n                            <use xlink:href=\"#icon-keyboard-arrow-down\"></use>\r\n                        </svg>\r\n                    </span>\r\n                </button>\r\n                <input type=\"tel\" class=\"form-input form-input--incrementTotal js-card-atc__input--total\" name=\"card-atc__qty-{{id}}\" id=\"card-atc__qty-{{id}}\" value=\"1\" min=\"1\" pattern=\"[0-9]*\" aria-live=\"polite\" tabindex=\"0\">\r\n                <button class=\"button button--icon\" data-action=\"inc\" type=\"button\" tabindex=\"0\">\r\n                    <span class=\"icon-wrapper\" aria-hidden=\"true\">\r\n                        <svg class=\"icon\">\r\n                            <use xlink:href=\"#icon-keyboard-arrow-up\"></use>\r\n                        </svg>\r\n                    </span>\r\n                </button>\r\n            </div>\r\n        </div>\r\n    </div>\r\n    <div class=\"card-atc__section card-atc__section--action adc-col\">\r\n        {{#if quantity '==' 0}}\r\n        <button type=\"button\" class=\"card-atc__button button adc-btn\" disabled>{{lang 'products.add_to_cart'}}</button>\r\n        <button type=\"button\" class=\"button parts s2 w-button adc-btn-mob\" disabled>{{lang 'products.add'}}</button>\r\n        {{else}}\r\n        <button type=\"button\" class=\"card-atc__button button button--primary js-card-atc__button adc-btn\" id=\"card-atc__add-{{id}}\" data-default-message=\"{{lang 'products.add_to_cart'}}\" data-wait-message=\"{{lang 'products.adding_to_cart'}}\" data-added-message=\"{{lang 'products.add_to_cart'}}\" value=\"{{lang 'products.add_to_cart'}}\" data-card-add-to-cart=\"/cart.php?action=add&amp;product_id={{id}}\" data-event-type=\"product-click\" tabindex=\"0\">{{lang 'products.add_to_cart'}}</button>\r\n        <button type=\"button\" class=\"button button--primary js-card-atc__button parts s2 w-button adc-btn-mob\" id=\"card-atc__add-{{id}}\" data-default-message=\"{{lang 'add'}}\" data-wait-message=\"…\" data-added-message=\"{{lang 'products.add'}}\" value=\"{{lang 'products.add'}}\" data-card-add-to-cart=\"/cart.php?action=add&amp;product_id={{id}}\" data-event-type=\"product-click\" tabindex=\"0\">{{lang 'products.add'}}</button>\r\n        <span class=\"product-status-message aria-description--hidden\">{{lang 'products.add_to_cart_item_added'}}</span>\r\n        {{/if}}\r\n    </div>\r\n    <div id=\"previewModal\" class=\"modal modal--large\" data-reveal>\r\n        <button class=\"modal-close\" type=\"button\" title=\"Close\">\r\n            <span class=\"aria-description--hidden\">{{lang 'common.close'}}</span>\r\n            <span aria-hidden=\"true\">&#215;</span>\r\n        </button>\r\n        <div class=\"modal-content\"></div>\r\n        <div class=\"loadingOverlay\"></div>\r\n    </div>\r\n</div>\r\n\r\n{{!-- /if --}}\r\n"
