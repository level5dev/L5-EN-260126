{
  "components/custom/header-1/header-top-container": "<div\r\n  id=\"header--top--container\"\r\n  class=\"header-1__top container\"\r\n  style=\"padding-top: 1px\"\r\n>\r\n  <div id=\"headerRotate\" class=\"header-1__shipping-container\">\r\n    {{#for 1 (lang\r\n    'custom.header.top-navigation.shipping-header.number-of-headers')}} {{!--#if\r\n    $index '!==' 1--}} {{#if (lang (concat (concat\r\n    'custom.header.top-navigation.shipping-header.header-'$index)'.expiry'))\r\n    '!==' 'null'}}\r\n    <div class=\"header--rotation\">\r\n      {{{lang (concat (concat\r\n      'custom.header.top-navigation.shipping-header.header-'$index)'.text')}}}\r\n    </div>\r\n    {{else}}\r\n    <div class=\"header--rotation\">\r\n      {{{lang (concat (concat\r\n      'custom.header.top-navigation.shipping-header.header-'$index)'.text')}}}\r\n    </div>\r\n    {{/if}} {{/for}}\r\n  </div>\r\n  {{> components/custom/header-1/header-1_top-nav}}\r\n</div>\r\n",
  "components/custom/header-1/header-1_top-nav": "<nav class=\"header-1__top-nav\">\r\n    <ul class=\"header-1__top-nav-list\">\r\n        {{!-- {{#for 1 (lang 'custom.header.top-navigation.number-of-links')}}\r\n        <li class=\"header-1__top-nav-list-item\">\r\n            <a href=\"{{lang (concat (concat 'custom.header.top-navigation.link-'$index)'.link')}}\"\r\n                class=\"header-1__top-nav-list-link\">\r\n                {{!lang (concat (concat 'custom.header.top-navigation.link-'$index)'.text')}}\r\n            </a>\r\n        </li>\r\n        {{/for}} --}}\r\n        <li class=\"header-1__top-nav-list-item\">\r\n            <a href=\"{{lang 'custom.header.top-navigation.link-1.link' }}\" class=\"header-1__top-nav-list-link\">\r\n                {{lang 'custom.header.top-navigation.link-1.text'}}\r\n            </a>\r\n        </li>\r\n        <li class=\"header-1__top-nav-list-item\">\r\n            <a href=\"{{lang 'custom.header.top-navigation.link-7.link' }}\" class=\"header-1__top-nav-list-link\">\r\n                {{lang 'custom.header.top-navigation.link-7.text'}}\r\n            </a>\r\n        </li>\r\n        <li class=\"header-1__top-nav-list-item hide-mobile\">\r\n            <a href=\"{{lang 'custom.header.top-navigation.link-8.link' }}\" class=\"header-1__top-nav-list-link\">\r\n                {{lang 'custom.header.top-navigation.link-8.text'}}\r\n            </a>\r\n        </li>\r\n        {{#if customer}}\r\n        <li class=\"header-1__top-nav-list-item account-link\">\r\n                <a class=\"navUser-action\"\r\n                   href=\"{{urls.account.index}}\"\r\n                   aria-label=\"{{lang 'common.account'}}\"\r\n                   data-dropdown=\"account-dropdown\"\r\n                >\r\n                <span class=\"header-1__top-nav-list-link\">\r\n                    {{lang 'common.account'}}\r\n                </span>\r\n                </a>\r\n\r\n                <div class=\"dropdown-menu header-1__top-account-dropdown\" id=\"account-dropdown\" data-dropdown-content aria-hidden=\"true\">\r\n                    <ul class=\"header-1__top-account-list\">\r\n                        <li class=\"header-1__top-account-list-item\">\r\n                            <a class=\"header-1__top-account-list-item-link\"\r\n                               href=\"{{urls.account.orders.all}}\"\r\n                               aria-label=\"{{lang 'account.nav.orders'}}\"\r\n                            >\r\n                                {{lang 'account.nav.orders'}}\r\n                            </a>\r\n                        </li>\r\n                        {{#if settings.returns_enabled}}\r\n                            <li class=\"header-1__top-account-list-item\">\r\n                                <a class=\"header-1__top-account-list-item-link\"\r\n                                   href=\"{{urls.account.returns}}\"\r\n                                   aria-label=\"{{lang 'account.nav.returns'}}\"\r\n                                >\r\n                                    {{lang 'account.nav.returns'}}\r\n                                </a>\r\n                            </li>\r\n                        {{/if}}\r\n                        <li class=\"header-1__top-account-list-item\">\r\n                            <a class=\"header-1__top-account-list-item-link\"\r\n                               href=\"{{urls.account.inbox}}\"\r\n                               aria-label=\"{{lang 'account.mobile_nav.messages'}}\"\r\n                            >\r\n                                {{lang 'account.mobile_nav.messages'}}\r\n                            </a>\r\n                        </li>\r\n                        <li class=\"header-1__top-account-list-item\">\r\n                            <a class=\"header-1__top-account-list-item-link\"\r\n                               href=\"{{urls.account.addresses}}\"\r\n                               aria-label=\"{{lang 'account.nav.addresses'}}\"\r\n                            >\r\n                                {{lang 'account.nav.addresses'}}\r\n                            </a>\r\n                        </li>\r\n                        {{#if settings.show_payment_methods}}\r\n                            <li class=\"header-1__top-account-list-item\">\r\n                                <a class=\"header-1__top-account-list-item-link\"\r\n                                   href=\"{{urls.account.payment_methods.all}}\"\r\n                                   aria-label=\"{{lang 'account.nav.payment_methods'}}\"\r\n                                >\r\n                                    {{lang 'account.nav.payment_methods'}}\r\n                                </a>\r\n                            </li>\r\n                        {{/if}}\r\n                        <li class=\"header-1__top-account-list-item\">\r\n                            <a class=\"header-1__top-account-list-item-link\"\r\n                               href=\"{{urls.account.wishlists.all}}\"\r\n                               aria-label=\"{{lang 'account.mobile_nav.wishlists'}}\"\r\n                            >\r\n                                {{lang 'account.mobile_nav.wishlists'}}\r\n                            </a>\r\n                        </li>\r\n                        <li class=\"header-1__top-account-list-item\">\r\n                            <a class=\"header-1__top-account-list-item-link\"\r\n                               href=\"{{urls.account.recent_items}}\"\r\n                               aria-label=\"{{lang 'account.nav.recently_viewed'}}\"\r\n                            >\r\n                                {{lang 'account.nav.recently_viewed'}}\r\n                            </a>\r\n                        </li>\r\n                        <li class=\"header-1__top-account-list-item\">\r\n                            <a class=\"header-1__top-account-list-item-link\"\r\n                               href=\"{{urls.account.details}}\"\r\n                               aria-label=\"{{lang 'account.nav.settings'}}\"\r\n                            >\r\n                                {{lang 'account.nav.settings'}}\r\n                            </a>\r\n                        </li>\r\n                        <li class=\"header-1__top-account-list-item\">\r\n                            <a class=\"header-1__top-account-list-item-link\"\r\n                            href=\"{{urls.auth.logout}}\"\r\n                            aria-label=\"{{lang 'common.logout'}}\"\r\n                            >\r\n                                {{lang 'common.logout'}}\r\n                            </a>\r\n                        </li>\r\n                    </ul>\r\n                </div>\r\n        </li>\r\n        {{else}}\r\n        <li class=\"header-1__top-nav-list-item\">\r\n            <a href=\"{{urls.auth.login}}\" class=\"header-1__top-nav-list-link login-link\">\r\n                {{lang 'custom.header.top-navigation.link-2.text'}}\r\n            </a>\r\n            <!-- <a href=\"{{urls.auth.create_account}}\" class=\"header-1__top-nav-list-link\">\r\n                {{!-- {{lang 'custom.header.top-navigation.link-3.text'}} --}}\r\n            </a> -->\r\n        </li>\r\n        {{/if}}\r\n        <li class=\"header-1__top-nav-list-item\">\r\n            <a href=\"{{lang 'custom.header.top-navigation.link-5.link'}}\" class=\"header-1__top-nav-list-link\">\r\n                {{lang 'custom.header.top-navigation.link-5.text'}}\r\n            </a>\r\n        </li>\r\n        <li class=\"header-1__top-nav-list-item hide-mobile\">\r\n            <a href=\"/blog/\" class=\"header-1__top-nav-list-link\">\r\n                {{lang 'custom.header.top-navigation.link-6.text'}}\r\n            </a>\r\n        </li>\r\n        {{!-- {{#if currency_selector.currencies.length '>' 1}}\r\n        <li class=\"header-1__top-nav-list-item\">\r\n            <a class=\"navUser-action navUser-action--currencySelector has-dropdown\" href=\"#\"\r\n                data-dropdown=\"currencySelection\" aria-controls=\"currencySelection\" aria-expanded=\"false\">\r\n                <span class=\"currency-flag {{lang 'common.currency' code=currency_selector.active_currency_code}}\">\r\n                    {{{currency_selector.active_currency_flag}}}\r\n                </span>\r\n                {{!lang 'common.currency' code=currency_selector.active_currency_code}}\r\n                <i class=\"icon\" aria-hidden=\"true\">\r\n                    <svg>\r\n                        <use xlink:href=\"#icon-chevron-down\" />\r\n                    </svg>\r\n                </i>\r\n            </a>\r\n            <ul class=\"dropdown-menu\" id=\"currencySelection\" data-dropdown-content aria-hidden=\"true\" tabindex=\"-1\">\r\n                {{#each currency_selector.currencies}}\r\n                <li class=\"dropdown-menu-item\">\r\n                    <a class=\"dropdown-menu-link\" href=\"{{{switch_url}}}\">\r\n                        {{#if is_active}}\r\n                        {{{flag}}}<strong>{{code}}</strong>\r\n                        {{else}}\r\n                        {{{flag}}}{{code}}\r\n                        {{/if}}\r\n                    </a>\r\n                </li>\r\n                {{/each}}\r\n            </ul>\r\n        </li>\r\n        {{/if}} --}}\r\n        <!--<li class=\"header-1__top-nav-list-item hide-mobile\" style=\"line-height: normal;\">\r\n         <!--           <a class=\"header-1__top-nav-list-link\" href=\"https://es.level5tools.com/\" style=\"display: flex; align-items: center;\">\r\n         <!--               <img src=\"https://upload.wikimedia.org/wikipedia/en/9/9a/Flag_of_Spain.svg\" alt=\"Spain Flag\" style=\"height: 12px;width: auto;margin-right: 5px;\">\r\n          <!--              ESPAÑOL\r\n        <!--            </a>           \r\n        </li>  -->\r\n    </ul>\r\n</nav>\r\n"
}
