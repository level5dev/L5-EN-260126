{
  "components/custom/return-policy": "<div id=\"modal-return-policy\" class=\"modal\" data-reveal data-prevent-quick-search-close>\n    {{> components/common/modal/popup-header }}\n        <!-- you can add any content inside the element below, including another template -->\n        <div class=\"modal-content modal-klarna\">\n            <div class=\"modal-div\">\n                <div class=\"text-block-4\">{{lang 'custom.page.support.return_policy.title'}}</div>\n                <div class=\"text-block-5\">{{lang 'custom.page.support.return_policy.text_1'}}</div>\n                <div class=\"text-block-5 success\">{{lang 'custom.page.support.return_policy.text_2'}}</div>\n                <div class=\"text-block-5 success\"></div>\n            </div> \n        </div>\n</div>\n\n<style>\n    @media screen and (max-width:551px){\n      #modal-return-policy{\n         min-height: 0vh;\n         width:90%;\n         top: 50%;\n         left: 50%;\n         transform: translate(-50%, -50%);\n      }\n   }\n</style>\n\n",
  "components/common/modal/popup-header": "<div class=\"modal-header\">\n    <img src=\"https://uploads-ssl.webflow.com/634d1196dfe3ee1059acb423/645086b0a698ed589c0e7f2c_643f493fef815326747b023c_image%2096.png\" loading=\"lazy\" alt=\"\">\n    {{!-- <div href=\"#\" class=\"modal-close\" style=\"text-decoration:none;\">\n        <span>×</span>\n    </div> --}}\n    {{> components/common/modal/modal-close-btn }}\n</div>\n",
  "components/common/modal/modal-close-btn": "<button class=\"modal-close\" type=\"button\" {{additional_attr}} >\n    {{!-- <span class=\"aria-description--hidden\">{{lang 'common.close'}}</span> --}}\n    <span aria-hidden=\"true\">&#215;</span>\n</button>\n"
}
