{
  "components/common/breadcrumbs-support": "{{!-- <nav aria-label=\"Breadcrumb\">\n    <ol class=\"breadcrumbs\" itemscope itemtype=\"https://schema.org/BreadcrumbList\" style=\"text-align: left;\">\n        <li class=\"breadcrumb\" itemprop=\"itemListElement\" itemscope itemtype=\"https://schema.org/ListItem\">\n            <a href=\"javascript:void(0)\" class=\"home-link\" onclick=\"goToHomePage()\">\n                <i class=\"fas fa-home\"></i>\n            </a>\n            <a class=\"breadcrumb-label\" itemprop=\"item\" href=\"{{url}}\">\n                <span itemprop=\"name\" style=\"text-transform: uppercase;font-weight: 400;\"> / {{lang 'common.customer_support'}}</span>\n            </a>\n            \n        </li>\n    </ol>\n</nav> --}}\n\n<nav aria-label=\"Breadcrumb\">\n    <ol class=\"breadcrumb-wicon\" itemscope itemtype=\"https://schema.org/BreadcrumbList\">\n        {{#unless theme_settings.hide_breadcrumbs }}\n            {{#each breadcrumbs}}\n                <li class=\"breadcrumb {{#if @last}}is-active{{/if}}\" itemprop=\"itemListElement\" itemscope itemtype=\"https://schema.org/ListItem\">\n                    <a class=\"breadcrumb-label\"\n                       itemprop=\"item\"\n                       href=\"{{url}}\"\n                       {{#if @last}}aria-current=\"page\"{{/if}}\n                    >\n                    {{!-- #if name '===' 'Home'}}\n                        <a href=\"javascript:void(0)\" class=\"home-link\" onclick=\"goToHomePage()\">\n                            <i class=\"fas fa-home\"></i>\n                        </a>\n                    {{else}}\n                        <span itemprop=\"name\">{{name}}</span>\n                    {{/if --}}\n                    <span itemprop=\"name\">{{name}}</span>\n                        \n\n                    </a>\n                    <meta itemprop=\"position\" content=\"{{add @index 1}}\" />\n                </li>\n            {{/each}}\n        {{/unless}}\n    </ol>\n</nav>\n<script>\n    function goToHomePage() {\n        window.location.href = window.location.origin;\n    }\n</script>\n"
