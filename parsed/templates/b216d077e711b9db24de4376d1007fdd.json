{
  "components/account/navigation": "<nav class=\"navBar navBar--sub navBar--account\">\r\n    <ul class=\"navBar-section\">\r\n        <li class=\"navBar-item {{#if account_page '===' 'orders'}}is-active{{/if}}\">\r\n            <a class=\"navBar-action\" href=\"{{urls.account.orders.all}}\">{{lang 'account.nav.orders'}}</a>\r\n        </li>\r\n        {{#if settings.returns_enabled}}\r\n            <li class=\"navBar-item {{#if account_page '===' 'returns'}}is-active{{/if}}\">\r\n                <a class=\"navBar-action\" href=\"{{urls.account.returns}}\">{{lang 'account.nav.returns'}}</a>\r\n            </li>\r\n        {{/if}}\r\n        {{!-- <li class=\"navBar-item {{#if account_page '===' 'messages'}}is-active{{/if}}\">\r\n            <a class=\"navBar-action\" href=\"{{urls.account.inbox}}\">{{lang 'account.nav.messages' num_new_messages=customer.num_new_messages}}</a>\r\n        </li> --}}\r\n        <li class=\"navBar-item {{#if account_page '===' 'addresses'}}is-active{{/if}}\">\r\n            <a class=\"navBar-action\" href=\"{{urls.account.addresses}}\">{{lang 'account.nav.addresses'}}</a>\r\n        </li>\r\n        {{#if settings.show_payment_methods}}\r\n            <li class=\"navBar-item {{#if account_page '===' 'payment_methods'}}is-active{{/if}}\">\r\n                <a class=\"navBar-action\" href=\"{{urls.account.payment_methods.all}}\">{{lang 'account.nav.payment_methods'}}</a>\r\n            </li>\r\n        {{/if}}\r\n        {{#if settings.show_wishlist}}\r\n            <li class=\"navBar-item {{#if account_page '===' 'wishlists'}}is-active{{/if}}\">\r\n                <a class=\"navBar-action\" href=\"{{urls.account.wishlists.all}}\">{{lang 'account.nav.wishlists'}}</a>\r\n            </li>\r\n        {{/if}}\r\n        <li class=\"navBar-item {{#if account_page '===' 'recent_items'}}is-active{{/if}}\">\r\n            <a class=\"navBar-action\" href=\"{{urls.account.recent_items}}\">{{lang 'account.nav.recently_viewed'}}</a>\r\n        </li>\r\n        <li class=\"navBar-item {{#if account_page '===' 'settings'}}is-active{{/if}}\">\r\n            <a class=\"navBar-action\" href=\"{{urls.account.details}}\">{{lang 'account.nav.settings'}}</a>\r\n        </li>\r\n        <li class=\"navBar-item\">\r\n            <a class=\"navBar-action\" href=\"{{urls.auth.logout}}\">{{lang 'account.nav.logout'}}</a>\r\n        </li>\r\n    </ul>\r\n</nav>\r\n\r\n<div class=\"actionBar filter--section\" mobile id=\"acc-navigation-ddown\">\r\n    <fieldset class=\"form-fieldset actionBar-section\" > \r\n        <div class=\"filter-mobile-wrapper\">\r\n            <div id=\"acc-nav-selector\" onclick=\"navigateToSelectedLink(this)\" class=\"nice-select navigation-select\" tabindex=\"0\">\r\n                <span class=\"current\">Select an option</span>\r\n                <ul class=\"list\">\r\n                    <li class=\"option nav-li{{#if account_page '===' 'orders'}}is-active{{/if}}\">\r\n                        <a class=\"navBar-action\" href=\"{{urls.account.orders.all}}\">{{lang 'account.nav.orders'}}</a>\r\n                    </li>\r\n                    {{#if settings.returns_enabled}}\r\n                        <li class=\"option nav-li{{#if account_page '===' 'returns'}}is-active{{/if}}\">\r\n                            <a class=\"navBar-action\" href=\"{{urls.account.returns}}\">{{lang 'account.nav.returns'}}</a>\r\n                        </li>\r\n                    {{/if}}\r\n                    <li class=\"option nav-li{{#if account_page '===' 'messages'}}is-active{{/if}}\">\r\n                        <a class=\"navBar-action\" href=\"{{urls.account.inbox}}\">{{lang 'account.nav.messages' num_new_messages=customer.num_new_messages}}</a>\r\n                    </li>\r\n                    <li class=\"option nav-li{{#if account_page '===' 'addresses'}}is-active{{/if}}\">\r\n                        <a class=\"navBar-action\" href=\"{{urls.account.addresses}}\">{{lang 'account.nav.addresses'}}</a>\r\n                    </li>\r\n                    {{#if settings.show_payment_methods}}\r\n                        <li class=\"option nav-li{{#if account_page '===' 'payment_methods'}}is-active{{/if}}\">\r\n                            <a class=\"navBar-action\" href=\"{{urls.account.payment_methods.all}}\">{{lang 'account.nav.payment_methods'}}</a>\r\n                        </li>\r\n                    {{/if}}\r\n                    {{#if settings.show_wishlist}}\r\n                        <li class=\"option nav-li{{#if account_page '===' 'wishlists'}}is-active{{/if}}\">\r\n                            <a class=\"navBar-action\" href=\"{{urls.account.wishlists.all}}\">{{lang 'account.nav.wishlists'}}</a>\r\n                        </li>\r\n                    {{/if}}\r\n                    <li class=\"option nav-li{{#if account_page '===' 'recent_items'}}is-active{{/if}}\">\r\n                        <a class=\"navBar-action\" href=\"{{urls.account.recent_items}}\">{{lang 'account.nav.recently_viewed'}}</a>\r\n                    </li>\r\n                    <li class=\"option {{#if account_page '===' 'settings'}}is-active{{/if}}\">\r\n                        <a class=\"navBar-action\" href=\"{{urls.account.details}}\">{{lang 'account.nav.settings'}}</a>\r\n                    </li>\r\n                    <li class=\"option\">\r\n                        <a class=\"navBar-action\" href=\"{{urls.auth.logout}}\">{{lang 'account.nav.logout'}}</a>\r\n                    </li>\r\n                </ul>\r\n            </div>\r\n        </div>\r\n    </fieldset>\r\n</div>\r\n<style>\r\n    .navBar-action {\r\n        padding: 0;\r\n    }\r\n    .nice-select .list {\r\n        width: 100%;\r\n        right: 0px;\r\n        left: unset;\r\n    }\r\n</style>\r\n<script>\r\n    function navigateToSelectedLink(element) {\r\n        $(element).toggleClass(\"open\");\r\n    }\r\n\r\n    function selectedAccNav(element) {\r\n        //$(element).toggleClass(\"selected\")\r\n        console.log($(element).text())\r\n        $(\"span.current\",\"#linkSelector\").text($(element).text())\r\n        console.log($(element).attr(\"data-value\"))\r\n        $(`[parts-li-btn=${$(element).attr(\"data-value\")}]`).click()\r\n\r\n    }\r\n</script>\r\n"
