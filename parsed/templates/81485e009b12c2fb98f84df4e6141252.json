{
  "components/category/sort-box": "<fieldset class=\"form-fieldset actionBar-section\">\n    <div class=\"form-field\">\n        {{!-- <label class=\"form-label\" for=\"sort\">{{lang 'common.sorter.sort_by'}}</label>\n        <select class=\"form-select form-select--small \" name=\"sort\" id=\"sort\" role=\"listbox\">\n            <option value=\"featured\" {{#if sort '==' 'featured'}}selected{{/if}}>{{lang 'common.sorter.featured'}}</option>\n            <option value=\"newest\" {{#if sort '==' 'newest'}}selected{{/if}}>{{lang 'common.sorter.newest'}}</option>\n            <option value=\"bestselling\" {{#if sort '==' 'bestselling'}}selected{{/if}}>{{lang 'common.sorter.top_sellers'}}</option>\n            <option value=\"alphaasc\" {{#if sort '==' 'alphaasc'}}selected{{/if}}>{{lang 'common.sorter.alpha_asc'}}</option>\n            <option value=\"alphadesc\" {{#if sort '==' 'alphadesc'}}selected{{/if}}>{{lang 'common.sorter.alpha_desc'}}</option>\n            <option value=\"avgcustomerreview\" {{#if sort '==' 'avgcustomerreview'}}selected{{/if}}>{{lang 'common.sorter.reviews'}}</option>\n            <option value=\"priceasc\" {{#if sort '==' 'priceasc'}}selected{{/if}}>{{lang 'common.sorter.price_asc'}}</option>\n            <option value=\"pricedesc\" {{#if sort '==' 'pricedesc'}}selected{{/if}}>{{lang 'common.sorter.price_desc'}}</option>\n            {{#if result_count}}\n                <option value=\"relevance\" {{#if sort '==' 'relevance'}}selected{{/if}}>{{lang 'common.sorter.relevance'}}</option>\n            {{/if}}\n        </select> --}}\n        <div class=\"filter-wrapper\" sort-block=\"\" style=\"background-color: unset;\">\n            <label class=\"form-label form-select--small\" for=\"sort\">Sort By:</label>\n            {{!-- <select class=\"form-select\" name=\"sort\" id=\"sort\" role=\"listbox\" style=\"display: none;\">\n                <option value=\"featured\" {{#if sort '==' 'featured'}}selected{{/if}}>{{lang 'common.sorter.featured'}}</option>\n                <option value=\"newest\" {{#if sort '==' 'newest'}}selected{{/if}}>{{lang 'common.sorter.newest'}}</option>\n                <option value=\"bestselling\" {{#if sort '==' 'bestselling'}}selected{{/if}}>{{lang 'common.sorter.top_sellers'}}</option>\n                <option value=\"alphaasc\" {{#if sort '==' 'alphaasc'}}selected{{/if}}>{{lang 'common.sorter.alpha_asc'}}</option>\n                <option value=\"alphadesc\" {{#if sort '==' 'alphadesc'}}selected{{/if}}>{{lang 'common.sorter.alpha_desc'}}</option>\n                <option value=\"avgcustomerreview\" {{#if sort '==' 'avgcustomerreview'}}selected{{/if}}>{{lang 'common.sorter.reviews'}}</option>\n                <option value=\"priceasc\" {{#if sort '==' 'priceasc'}}selected{{/if}}>{{lang 'common.sorter.price_asc'}}</option>\n                <option value=\"pricedesc\" {{#if sort '==' 'pricedesc'}}selected{{/if}}>{{lang 'common.sorter.price_desc'}}</option>\n                {{#if result_count}}\n                    <option value=\"relevance\" {{#if sort '==' 'relevance'}}selected{{/if}}>{{lang 'common.sorter.relevance'}}</option>\n                {{/if}}\n            </select> --}}\n            <div class=\"nice-select form-select\">\n                <span class=\"current\">Default</span><ul class=\"list\">\n                    <li class=\"option\" data-value=\"featured\" {{#if sort '==' 'featured'}}selected{{/if}}>{{lang 'common.sorter.featured'}}</li>\n                    <li class=\"option\" data-value=\"newest\" {{#if sort '==' 'newest'}}selected{{/if}}>{{lang 'common.sorter.newest'}}</li>\n                    <li class=\"option\" data-value=\"bestselling\" {{#if sort '==' 'bestselling'}}selected{{/if}}>{{lang 'common.sorter.top_sellers'}}</li>\n                    <li class=\"option\" data-value=\"alphaasc\" {{#if sort '==' 'alphaasc'}}selected{{/if}}>{{lang 'common.sorter.alpha_asc'}}</li>\n                    <li class=\"option\" data-value=\"alphadesc\" {{#if sort '==' 'alphadesc'}}selected{{/if}}>{{lang 'common.sorter.alpha_desc'}}</li>\n                    <li class=\"option\" data-value=\"avgcustomerreview\" {{#if sort '==' 'avgcustomerreview'}}selected{{/if}}>{{lang 'common.sorter.reviews'}}</li>\n                    <li class=\"option\" data-value=\"priceasc\" {{#if sort '==' 'priceasc'}}selected{{/if}}>{{lang 'common.sorter.price_asc'}}</li>\n                    <li class=\"option\" data-value=\"pricedesc\" {{#if sort '==' 'pricedesc'}}selected{{/if}}>{{lang 'common.sorter.price_desc'}}</li>\n                    {{#if result_count}}\n                        <li class=\"option\" data-value=\"relevance\" {{#if sort '==' 'relevance'}}selected{{/if}}>{{lang 'common.sorter.relevance'}}</li>\n                    {{/if}}\n                </ul>\n            </div>\n        </div>\n    </div>\n</fieldset>\n<script>\n    $('[sort-block]').on('click', function(){\n        $('.nice-select',$(this)).toggleClass('open')\n    })\n\n    $('[data-value]').on('click', function() {\n        let selectedVal = $(this).data('value')\n        let sortName = $(this).text()\n        //console.log(selectedVal)\n        //console.log(selectedName)\n        selectedName(sortName)\n        // var currentUrl = window.location.href;\n        // var newUrl = currentUrl.replace(/(sort=)[^\\&]+/, '$1' + selectedVal);\n        // window.location.href = newUrl;\n\n        var currentUrl = window.location.href;\n        if (currentUrl.indexOf('sort=') === -1) {\n            // If 'sort' parameter is not present, add it\n            currentUrl += (currentUrl.indexOf('?') === -1 ? '?' : '&') + 'sort=' + selectedVal;\n        } else {\n            // If 'sort' parameter is present, update its value\n            currentUrl = currentUrl.replace(/(sort=)[^\\&]+/, '$1' + selectedVal);\n        }\n        var newUrl = currentUrl.replace(/(sort=)[^\\&]+/, '$1' + selectedVal);\n        window.location.href = newUrl;\n    })\n\n    var sortValue = new URLSearchParams(window.location.search).get(\"sort\");\n    //console.log($(`[data-value=\"${sortValue}\"]`).text())\n    //$('.nice-select .current').text($(`[data-value=\"${sortValue}\"]`).text());\n    function selectedName(name) {\n        //console.log(name)\n        $('.nice-select .current').text(name);\n    }\n\n    if (sortValue) {\n        selectedName($(`[data-value=\"${sortValue}\"]`).text())\n    }\n</script>\n"
}
