{
  "components/custom/tool-types/automatic-taper": "<div id=\"tooltype-popup-{{toolid}}\" class=\"modal tooltype--popup\" data-reveal style=\"width: 794px; max-height: 642px; min-height: auto;\">\r\n  {{> components/common/modal/popup-header }}\r\n\r\n  <div class=\"modal-body\" style=\"padding-top: 0px; min-height:fit-content;\">\r\n    <h1 style=\"margin: 0px;text-align:center;\"><strong>TAPE UP TO <span style=\"color: #e60012;\">300% FASTER.</span></strong></h1>\r\n\r\n    <div class=\"taper-images-wrapper\">\r\n      <div class=\"taper-image\" style=\"background-image: url('https://www.level5tools.com/content/set-builder/taper-1.webp');background-position-y:25%;\"></div>\r\n      <div class=\"taper-image\" style=\"background-image: url('https://www.level5tools.com/content/set-builder/tape-2.webp');background-position-y:43%;\"></div>\r\n    </div>   \r\n\r\n    <p>\r\n      If you’re planning to tackle large commercial or residential projects, an automatic taper will dramatically speed up your taping workflow. \r\n      It applies both tape & mud at the same time making quick work of flat seams and inside corners.\r\n    </p>\r\n\r\n    <p>\r\n      When selected, it will automatically add a gooseneck to your tool set to ensure you can fill up your taper. \r\n    </p>\r\n\r\n    <h2><strong>GET TO KNOW THE TAPER</strong></h2>\r\n\r\n    <p>Watch Scott Murray go over the design, build, and usage of the LEVEL5 Automatic Taper.</p>\r\n\r\n    <div class=\"video-section\">\r\n      <div class=\"video-embed\">\r\n        <iframe src=\"https://www.youtube.com/embed/d5CQbj9fomg\" title=\"LEVEL5 Automatic Taper\" frameborder=\"0\" allowfullscreen></iframe>\r\n      </div>\r\n      <div class=\"video-embed\">\r\n        <iframe src=\"https://www.youtube.com/embed/87k08gxC8J8\" title=\"LEVEL5 Automatic Taper\" frameborder=\"0\" allowfullscreen></iframe>\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n</div>\r\n",
  "components/common/modal/popup-header": "<div class=\"modal-header\">\n    <img src=\"https://uploads-ssl.webflow.com/634d1196dfe3ee1059acb423/645086b0a698ed589c0e7f2c_643f493fef815326747b023c_image%2096.png\" loading=\"lazy\" alt=\"\">\n    {{!-- <div href=\"#\" class=\"modal-close\" style=\"text-decoration:none;\">\n        <span>×</span>\n    </div> --}}\n    {{> components/common/modal/modal-close-btn }}\n</div>\n",
  "components/common/modal/modal-close-btn": "<button class=\"modal-close\" type=\"button\" {{additional_attr}} >\n    {{!-- <span class=\"aria-description--hidden\">{{lang 'common.close'}}</span> --}}\n    <span aria-hidden=\"true\">&#215;</span>\n</button>\n"
}
