{
  "components/custom/schematic/table-body": "<td class=\"index-wrapper\" style=\"justify-content:center;\">\r\n    <div class=\"index-round\">{{index}}</div>\r\n</td>\r\n<td class=\"\">{{sku}}</td>\r\n<td class=\"\">\r\n    <div class=\"item--name\">{{name}}</div>\r\n    {{#if quantity '==' 0}}\r\n    <p class=\"text-sm-red\">Not Available</p>\r\n    {{/if}}\r\n</td>\r\n{{!-- #if price '==' '0'}}\r\n    <div class=\"grid-item\"></div>\r\n    <div class=\"grid-item js-card-atc\" style=\"justify-content: end;\">\r\n        <button class=\"button sch-btn-disabled\" disabled>{{lang 'unavailable.text'}}</button>\r\n    </div>\r\n{{else --}}\r\n<td id=\"\" class=\"\">${{price}}</td>\r\n<td>\r\n    <div class=\"grid-item js-card-atc\">\r\n        <div class=\"card-atc__section card-atc__section--qty\">\r\n            <label for=\"card-atc__qty-{{id}}\" class=\"card-atc__label is-srOnly\">{{lang 'products.quantity'}}:</label>\r\n            <div class=\"card-atc-increment--has-buttons js-card-atc-increment\">\r\n                <div class=\"form-increment incr-mob\">\r\n                    <button class=\"button button--icon\" data-action=\"dec\" type=\"button\" tabindex=\"0\">\r\n                        <span class=\"icon-wrapper\" aria-hidden=\"true\">\r\n                            <svg class=\"icon\">\r\n                                <use xlink:href=\"#icon-keyboard-arrow-down\"></use>\r\n                            </svg>\r\n                        </span>\r\n                    </button>\r\n                    <input type=\"tel\" class=\"form-input form-input--incrementTotal js-card-atc__input--total\" name=\"card-atc__qty-{{id}}\" id=\"card-atc__qty-{{id}}\" value=\"1\" min=\"1\" pattern=\"[0-9]*\" aria-live=\"polite\" tabindex=\"0\">\r\n                    <button class=\"button button--icon\" data-action=\"inc\" type=\"button\" tabindex=\"0\">\r\n                        <span class=\"icon-wrapper\" aria-hidden=\"true\">\r\n                            <svg class=\"icon\">\r\n                                <use xlink:href=\"#icon-keyboard-arrow-up\"></use>\r\n                            </svg>\r\n                        </span>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div class=\"card-atc__section card-atc__section--action adc-col\">\r\n            {{#if quantity '==' 0}}\r\n            <button type=\"button\" class=\"card-atc__button button adc-btn\" disabled>{{lang 'products.add_to_cart'}}</button>\r\n            <button type=\"button\" class=\"button parts s2 w-button adc-btn-mob\" disabled>{{lang 'products.add'}}</button>\r\n            {{else}}\r\n            <button type=\"button\" class=\"card-atc__button button button--primary js-card-atc__button adc-btn\" id=\"card-atc__add-{{id}}\" data-default-message=\"{{lang 'products.add_to_cart'}}\" data-wait-message=\"{{lang 'products.adding_to_cart'}}\" data-added-message=\"{{lang 'products.add_to_cart'}}\" value=\"{{lang 'products.add_to_cart'}}\" data-card-add-to-cart=\"/cart.php?action=add&amp;product_id={{id}}\" data-event-type=\"product-click\" tabindex=\"0\">{{lang 'products.add_to_cart'}}</button>\r\n            <button type=\"button\" class=\"button button--primary js-card-atc__button parts s2 w-button adc-btn-mob\" id=\"card-atc__add-{{id}}\" data-default-message=\"{{lang 'add'}}\" data-wait-message=\"…\" data-added-message=\"{{lang 'products.add'}}\" value=\"{{lang 'products.add'}}\" data-card-add-to-cart=\"/cart.php?action=add&amp;product_id={{id}}\" data-event-type=\"product-click\" tabindex=\"0\">{{lang 'products.add'}}</button>\r\n            <span class=\"product-status-message aria-description--hidden\">{{lang 'products.add_to_cart_item_added'}}</span>\r\n            {{/if}}\r\n        </div>\r\n        <div id=\"previewModal\" class=\"modal modal--large\" data-reveal>\r\n            <button class=\"modal-close\" type=\"button\" title=\"{{lang 'common.close'}}\">\r\n                <span class=\"aria-description--hidden\">{{lang 'common.close'}}</span>\r\n                <span aria-hidden=\"true\">&#215;</span>\r\n            </button>\r\n            <div class=\"modal-content\"></div>\r\n            <div class=\"loadingOverlay\"></div>\r\n        </div>\r\n    </div>\r\n</td>\r\n{{!-- /if --}}\r\n"
}
