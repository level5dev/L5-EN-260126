  "components/custom/product/credit-key": "<script crossorigin src=\"https://unpkg.com/@credit-key/creditkey-js@latest/umd/creditkey-js.js\"></script>\n\n{{!-- <div id=\"creditkeypdp\" style=\"margin-bottom:{{margin}};margin-left:-6px;\"></div> --}}\n<div id=\"creditkeypdp\" {{!-- style=\"margin-bottom:-55px; --}}\"></div>\n<script>\n    let ckPrice = document.getElementsByClassName('price price--withoutTax')[0].innerHTML.replace(/,|\\$/g, '');\n    let client = new ck.Client('level_912fb11184834a4dbec915e772e86fe2', 'production');\n    let charges = new ck.Charges(ckPrice, 0, 0, 0, ckPrice);//Pass product price into the Charges object\n    creditkeypdp.innerHTML = client.get_pdp_display(charges);\n    \n    // console.log(client.get_pdp_display(charges));\n    $(document).ready(function() {\n        $(window).on('resize', function () {\n        var isMobile = $(window).width() <= 767; // Adjust the width threshold as needed\n        var marginValue = isMobile ? ($('.klarna-btn-div').find('.klarna-btn').length > 0 ? '-25px' : '-35px') : '';\n\n        $('#creditkeypdp').css('margin-bottom', marginValue);\n        }).trigger('resize'); // Trigger the resize event on page load\n\n    })\n    \n\n</script>\n<style>\n    #creditkeypdp {\n        margin-bottom: -55px;\n    }\n\n    @media (max-width: 467px) {\n        #creditkeypdp {\n            margin-bottom: -35px;\n        }\n    }\n</style>\n"
}
