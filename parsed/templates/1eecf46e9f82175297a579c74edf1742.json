{
  "components/custom/product/product-breadcrumbs": "<nav aria-label=\"Breadcrumb\">\n    <ol class=\"breadcrumbs\" itemscope itemtype=\"https://schema.org/BreadcrumbList\">\n        {{#unless theme_settings.hide_breadcrumbs }}\n            {{#each breadcrumbs}}\n                {{#if @last}}\n                    \n                {{else}}\n                    <li class=\"breadcrumb\" itemprop=\"itemListElement\" itemscope itemtype=\"https://schema.org/ListItem\">\n                    <a class=\"breadcrumb-label\"\n                       itemprop=\"item\"\n                       href=\"{{url}}\"\n                       {{#if @last}}aria-current=\"page\"{{/if}}\n                    >\n                        <span itemprop=\"name\">{{name}}</span>\n   \n                    </a>\n                    <meta itemprop=\"position\" content=\"{{add @index 1}}\" />\n                </li>\n                {{/if}}\n                \n            {{/each}}\n        {{/unless}}\n    </ol>\n</nav>\n<style>\n    .breadcrumb-label {\n        text-transform: uppercase;\n    }\n\n    .breadcrumb-mobile {\n        .breadcrumbs {\n            display: flex;\n            justify-content: center;\n        }\n    }\n</style>\n<script>\n(function () {\n    const bc_list = document.querySelector('.product-page--breadcrumb.breadcrumb-mobile ol');\n\n    // Remove all li elements except the first and second last\n    Array.from(bc_list.children).slice(1, -1).forEach(li => li.remove());\n\n    // Keep only the first and second last li elements\n   // bc_list.innerHTML = `<li>${bc_list.firstElementChild.innerHTML}</li>${bc_list.lastElementChild.outerHTML}`;\n\n    }\n)();\n</script>\n"
}
