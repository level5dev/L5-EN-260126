{
  "components/products/modals/videoView": "<style>\n    .-modal-content.videoView-modal-content {\n      position: absolute;\n      top: 50%;\n      left: 50%;\n      transform: translate(-50%, -50%);\n      text-align: center;\n      width: 80%;\n      max-width: 800px;\n      background-color: transparent;\n      box-sizing: border-box;\n      box-shadow: 0px 0px 30px #000000;\n    }\n  \n    .videoView-close {\n      position: absolute;\n      top: 10px;\n      right: 10px;\n      font-size: 30px;\n      cursor: pointer;\n    }\n  \n    iframe {\n      width: 100%;\n      height: 450px;\n      display: block;\n      margin: 0 auto;\n    }\n  \n    @media screen and (max-width: 1024px) {\n      iframe {\n        height: 417px;\n      }\n    }\n  \n    @media screen and (max-width: 897px) {\n      iframe {\n        height: 327px;\n      }\n    }\n  \n    @media screen and (max-width: 768px) {\n      iframe {\n        height: 270px;\n      }\n    }\n  \n    @media screen and (max-width: 469px) {\n      iframe {\n        height: 220px;\n      }\n    }\n  \n    @media screen and (max-width: 369px) {\n      iframe {\n        height: 174px;\n      }\n    }\n  \n    /* Previous and Next buttons at the corners */\n    .videoView-nav-btn {\n      position: absolute;\n      top: 50%;\n      font-size: 24px;\n      cursor: pointer;\n      transform: translateY(-50%);\n    }\n  </style>\n  <div id=\"videoModal\" class=\"videoView-modal\" data-content-type=\"{{type}}\">\n    <span class=\"videoView-close white\" onclick=\"closeModal()\" videoView-btn\n      >&times;</span\n    >\n    <div class=\"-modal-content videoView-modal-content\">\n      <iframe\n        id=\"videoFrame\"\n        frameborder=\"0\"\n        allow=\"autoplay; encrypted-media\"\n        allowfullscreen\n      ></iframe>\n    </div>\n    <span\n      class=\"videoView-nav-btn videoView-prev-btn\"\n      onclick=\"prevVideo()\"\n      videoView-btn\n      ><i class=\"fas fa-arrow-left white\"></i\n    ></span>\n    <span\n      class=\"videoView-nav-btn videoView-next-btn\"\n      onclick=\"nextVideo()\"\n      videoView-btn\n      ><i class=\"fas fa-arrow-right white\"></i\n    ></span>\n  </div>\n  <script src=\"https://code.jquery.com/jquery-3.6.0.min.js\"></script>\n  <script>\n    //console.log('vieww')\n    //console.log($('#videoModal').data('content-type'))\n    let type = $(\"#videoModal\").data(\"content-type\");\n    var modal = document.getElementById(\"videoModal\");\n    // if (type == 'tab') {\n    // console.log('tab here')\n  \n    var videoIds = [],\n      videoCount = $(\n        '[data-tabcon=\"tab-videos\"] .videoView-thumbnail-link'\n      ).length;\n  \n    $(\".videoView-thumbnail-link\").each(function () {\n      var videoId = $(this).data(\"video-id\");\n      videoIds.push(videoId);\n    });\n  \n    var currentVideoIndex = 0;\n    function closeModal() {\n      $(\".slick-next.slick-arrow,.slick-prev.slick-arrow\").css(\"z-index\", \"1\");\n      $(\"#videoFrame\").attr(\"src\", \"\");\n      modal.style.display = \"none\";\n    }\n  \n    function prevVideo() {\n      currentVideoIndex =\n        (currentVideoIndex - 1 + videoIds.length) % videoIds.length;\n      loadVideo(videoIds[currentVideoIndex]);\n    }\n  \n    function nextVideo() {\n      currentVideoIndex = (currentVideoIndex + 1) % videoIds.length;\n      loadVideo(videoIds[currentVideoIndex]);\n    }\n  \n    function loadVideo(videoId) {\n      var videoSrc = \"https://www.youtube.com/embed/\" + videoId;\n      $(\"#videoFrame\").attr(\"src\", videoSrc);\n    }\n  \n    $(\".videoView-thumbnail-link\").on(\"click\", function (e) {\n    e.preventDefault();\n    //console.log(\"video click\");\n    var videoId = $(this).data(\"video-id\");\n    currentVideoIndex = videoIds.indexOf(videoId);\n    loadVideo(videoId);\n    modal.style.display = \"block\";\n    $(\".header-1__bottom,.header-1 .navPages-container-title,.navUser\").css(\n        \"z-index\",\n        \"1\"\n    );\n    $(\".slick-next.slick-arrow,.slick-prev.slick-arrow\").css(\"z-index\", \"0\");\n    });\n  \n    var timer;\n    function hideButtons() {\n      $(\"[videoView-btn]\").css(\"opacity\", 0);\n    }\n  \n    function showButtons() {\n      $(\"[videoView-btn]\").css(\"opacity\", 1);\n    }\n  \n    $(document).on(\"mousemove\", function () {\n      showButtons();\n      clearTimeout(timer);\n      timer = setTimeout(hideButtons, 3000);\n    });\n    showButtons();\n  \n    if (videoCount <= 1) {\n      $(\".videoView-nav-btn.videoView-prev-btn\").hide();\n      $(\".videoView-nav-btn.videoView-next-btn\").hide();\n    }\n    //}\n  </script>\n  \n"
}
