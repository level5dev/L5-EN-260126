  "components/custom/pdp-schematics-template": "<div data-its-tab=\"Schematics\">\n    <h2 class=\"tab-content-header\">{{lang 'custom.page.parts-components.schematics'}}</h2>\n    <div class=\"schematics\">\n        {{#for 1 (lang 'custom.page.pdp.schematic_part_components.total')}}\n            <div class=\"schematic\">\n                <div class=\"schematic__image\">\n                    <img src=\"{{lang (concat (concat 'custom.page.pdp.schematic_part_components.item_' $index) '.schematic_link')}}\" alt=\"{{lang (concat (concat 'custom.page.pdp.schematic_part_components.item_' $index) '.title')}}\">\n                </div>\n                <div class=\"schematic__content\">\n                    <h3 class=\"h5\">{{lang (concat (concat 'custom.page.pdp.schematic_part_components.item_' $index) '.name')}}</h3>\n                    <a class=\"button\" href=\"{{lang (concat (concat 'custom.page.pdp.schematic_part_components.item_' $index) '.schematic_link')}}\">{{lang 'custom.page.parts-components.table.schematic'}}</a>\n                    {{#if (lang (concat (concat 'custom.page.pdp.schematic_part_components.item_' $index) '.part_link')) '!==' ''}}\n                    <a class=\"button\" href=\"{{lang (concat (concat 'custom.page.pdp.schematic_part_components.item_' $index) '.part_link')}}\">{{lang 'custom.page.parts-components.table.parts_list'}}</a>\n                    {{/if}}\n                    <a class=\"button button--pdf\" target=\"_blank\" rel=\"noreferrer\" href=\"{{lang (concat (concat 'custom.page.pdp.schematic_part_components.item_' $index) '.pdf')}}\">{{lang 'custom.page.parts-components.table.download_pdf'}}</a>\n                </div>\n            </div> \n        {{/for}}\n{{!--\n        <div class=\"schematic\">\n            <div class=\"schematic__image\">\n                <img src=\"/content/schematics/its-3-w-handle/tube-assembly-schematic.gif\" alt=\"Tube Assembly Schematic\">\n            </div>\n            <div class=\"schematic__content\