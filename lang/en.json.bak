    "checkout": {
        "confirmation_text": "<div class='accept-tnc--text'><b>By placing your order</b>, you confirm that (1) you have <strong>read and agree</strong> to the LEVEL5 <a id='modal-tnc' target='_blank'>Terms of Use</a>, (2) <strong>you direct</strong> LEVEL5 to disclose my personal, payment and purchase information for payment verification and processing, and (3) you have <strong>read and agree</strong> to the LEVEL5 <a id='modal-policy' target='_blank'>Privacy Policy</a>.</div>",
        "coupon_text": "<p class='coupon-text-append'>Using a coupon code will provide you with a discount and automatically register you into the LEVEL5 VIP Club (it's free). <a href='/vip' target='_blank'>Learn More</a> about the benefits of membership.<p>",
