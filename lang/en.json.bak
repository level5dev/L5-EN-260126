        "popup_text_mob": "<div class='checkout-popup mobile'><div class='checkout-popuptext'><img class='popup-icon' src='https://uploads-ssl.webflow.com/634d1196dfe3ee1059acb423/6449e3aa4c8132e9bed78912_verified%201.png'><div class='popup-text'>This is a secure transaction</div></div><div class='checkout-popuptext'><img class='popup-icon' src='https://uploads-ssl.webflow.com/634d1196dfe3ee1059acb423/6449e3aaf6e64b89240520f7_headphone%201.png'><div class='popup-text'>Industry leading <span id='customer-service-mob' class='popup-textspan'>customer service </span>& <span id='warranties-mob' class='popup-textspan'>warranties</span></div></div><div class='checkout-popuptext'><img class='popup-icon' src='https://uploads-ssl.webflow.com/634d1196dfe3ee1059acb423/6449e3aafcf06474d509615e_product-return%201.png'><div id='return-policy-mob' class='popup-text'>Hassle free <span class='popup-textspan'>return policy</span></div></div></div>",
